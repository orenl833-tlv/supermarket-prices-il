{
  "name": "supermarket-prices-il",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @spil/api & npm run dev -w @spil/web",
    "build": "npm run build -w @spil/web",
    "start": "npm start -w @spil/api"
  },
  "engines": {
    "node": ">=22"
  }
}
