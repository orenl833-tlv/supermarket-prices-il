# Postgres connection for the pipeline
DATABASE_URL=postgres://postgres@localhost:5432/spil
# Comma-separated CBS locality codes of the cities to load (5000 = Tel Aviv-Yafo)
CITY_CODES=5000
# Throwaway database for integration tests (its schema is dropped on every run)
TEST_DATABASE_URL=postgres://postgres@localhost:5432/spil_test
# Also load Carrefour and Victory (their portals answer Israeli IP addresses only)
# ISRAEL_CHAINS=1
